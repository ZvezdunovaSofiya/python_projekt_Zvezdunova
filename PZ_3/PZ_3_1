a = input("Введите целое число A: ")
b = input("Введите целое число B: ")
c = input("Введите целое число C: ")

while type(a) != int:
    try: a = int(a)
    except ValueError:
        print("Неправильно ввели!")
        a = input("Введите A: ")

while type(b) != int:
    try: b = int(b)
    except ValueError:
        print("Неправильно ввели!")
        b = input("Введите B: ")

while type(c) != int:
    try: c = int(c)
    except ValueError:
        print("Неправильно ввели!")
        c = input("Введите C: ")

if a > 0 and b > 0 and c > 0:
    print("Истина. Все числа положительные.")
else:
    print("Ложь.")
